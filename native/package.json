{
  "name": "twilight-native",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor native shell (iOS/Android) for the Twilight PWA. The web app itself lives one directory up; `npm run sync` stages it into www/ and updates the native projects.",
  "scripts": {
    "sync": "node sync-web.js && npx cap sync",
    "sync:web": "node sync-web.js && npx cap copy",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
